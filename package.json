{
  "name": "codeit-fs-layered-architecture-starter",
  "version": "1.0.0",
  "description": "",
  "main": "./src/server.js",
  "type": "module",
  "imports": {
    "#generated/*": "./generated/*",
    "#config": "./src/config/config.js",
    "#db/*": "./src/db/*",
    "#repository": "./src/repository/index.js",
    "#constants": "./src/constants/index.js",
    "#utils": "./src/utils/index.js",
    "#middlewares": "./src/middlewares/index.js",
    "#exceptions": "./src/exceptions/index.js"
  },
  "scripts": {
    "dev": "nodemon --env-file=./env/.env.development ./src/server.js",
    "prod": "node --env-file=./env/.env.production src/server.js",
    "prisma:push": "dotenv -e ./env/.env.development -- prisma db push",
    "prisma:migrate": "dotenv -e ./env/.env.development -- prisma migrate dev",
    "prisma:studio": "dotenv -e ./env/.env.development -- prisma studio",
    "prisma:generate": "dotenv -e ./env/.env.development -- prisma generate",
    "seed": "pnpm run prisma:generate && node --env-file=./env/.env.development ./scripts/seed.js",
    "verify:api": "node --env-file=./env/.env.development ./scripts/verify-api.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=26.7.0 <27"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv-cli": "^11.0.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "eslint": "^10.9.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0"
  }
}
