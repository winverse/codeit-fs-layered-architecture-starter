{
  "name": "codeit-fs-layered-architecture-starter",
  "version": "1.0.0",
  "description": "",
  "main": "./src/server.js",
  "type": "module",
  "imports": {
    "#config": "./src/config/config.js",
    "#prisma/*": "./src/prisma/*",
    "#repositories": "./src/repositories/index.js",
    "#constants": "./src/common/constants/index.js",
    "#utils": "./src/utils/index.js",
    "#exceptions": "./src/common/exceptions/index.js",
    "#controllers": "./src/controllers/index.js",
    "#services": "./src/services/index.js",
    "#middlewares": "./src/middlewares/index.js",
    "#providers": "./src/providers/index.js"
  },
  "scripts": {
    "dev": "nodemon --env-file=./env/.env.development ./src/server.js",
    "prod": "node --env-file=./env/.env.production src/server.js",
    "prisma:emit": "dotenv -e ./env/.env.development -- prisma contract emit --format human",
    "prisma:init": "dotenv -e ./env/.env.development -- prisma db init --format human",
    "prisma:update": "dotenv -e ./env/.env.development -- prisma db update --format human",
    "seed": "node --env-file=./env/.env.development ./scripts/seed.js",
    "verify:api": "node --env-file=./env/.env.development ./scripts/verify-api.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.11",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv-cli": "^11.0.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.9.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "prisma": "8.0.0-rc.15"
  }
}
