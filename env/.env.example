# 환경 설정
NODE_ENV=development

# 서버 포트
PORT=5001

# PostgreSQL 연결 URL
DATABASE_URL="postgresql://<사용자명>:<비밀번호>@localhost:5432/prisma_auth"

# 서로 다른 32자 이상의 비밀키
JWT_ACCESS_SECRET="<32자 이상의 임의 문자열>"
JWT_REFRESH_SECRET="<위 값과 다른 32자 이상의 임의 문자열>"

# 쉼표로 구분한 운영 환경 허용 출처. 개발 환경에서는 비워 둘 수 있습니다.
CORS_ORIGINS=
