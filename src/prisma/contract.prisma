// use prisma-8
model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  name     String?
  password String

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@map("users")
  @@index(expression: "lower(email)", unique: true, name: "users_email_lower_key")
}
